# Email Provider: Resend (https://resend.com)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="notificaciones@jfarquidisenos.com"

# Mobile / SMS / WhatsApp Provider: Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_PHONE="+1234567890"

# WhatsApp Cloud API (Meta Developers) - Optional alternative
WHATSAPP_API_TOKEN="your_meta_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
